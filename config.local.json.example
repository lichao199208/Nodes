{
  "mail_provider": "yunxin",
  "mail_api_base": "https://mail.example.com",
  "mail_api_key": "YOUR_MAIL_API_KEY",
  "mail_type": "mail",
  "mail_suffix": "mail.com",
  "mail_domain": "",
  "yyds_api_key": "在此填入你的 YYDS Mail API Key",
  "yyds_domain": "",
  "captcha_provider": "2captcha",
  "captcha_api_key": "YOUR_2CAPTCHA_API_KEY",
  "captcha_api_base": "https://api.2captcha.com",
  "captcha_timeout": 180,
  "captcha_poll_interval": 5,
  "turnstile_extension_path": "",
  "web_username": "admin",
  "web_password_hash": "GENERATE_WITH_werkzeug.security.generate_password_hash",
  "web_session_secret": "YOUR_WEB_SESSION_SECRET",
  "resin_gateway_host": "127.0.0.1",
  "resin_gateway_port": 8970,
  "resin_gateway_platform": "Nodes",
  "pool_slots_per_account": 8,
  "pool_auto_register": true,
  "export_proxy_protocol": "http",
  "pull_api_base": "http://127.0.0.1:8892/api",
  "pull_api_user": "",
  "pull_api_pass": "YOUR_PULL_API_PASS",
  "pull_api_shuliang": 100,
  "pull_api_id": 1,
  "proxy_quality_enabled": true,
  "proxy_max_latency_ms": 3000,
  "proxy_exclude_countries": "US",
  "proxy_arp_check_enabled": true,
  "proxy_arp_probe_url": "https://firefly-3p.ff.adobe.io/",
  "arp_publish_url": "",
  "arp_publish_token": "YOUR_ARP_PUBLISH_TOKEN",
  "proxy_quality_workers": 16,
  "proxy_quality_cache_ttl_sec": 600,
  "export_token": "YOUR_EXPORT_TOKEN",
  "http_proxy": "",
  "https_proxy": ""
}
